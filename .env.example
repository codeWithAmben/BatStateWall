# Copy this file to ".env" for local development and replace the placeholders.
# Use your Supabase Session Pooler connection string from Project Settings > Database.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Optional local server port (Render automatically provides PORT in production)
PORT=3000

# Long random secret used to sign HTTP-only session cookies
SESSION_SECRET=replace-with-a-long-random-secret

# Optional: Google OAuth 2.0 credentials for "Continue with Google (Gmail)" login
# Create these in Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional: auto-detected from request host if omitted
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
